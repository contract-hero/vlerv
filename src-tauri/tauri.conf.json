{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vlerv",
  "version": "0.1.0",
  "identifier": "dev.vlerv.Vlerv",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vlerv",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["vlerv"]
      }
    }
  }
}
